# Copie para .env e preencha. O .env nunca vai para o Git.

# Base de dados (MySQL)
DB_HOST=localhost
DB_NAME=rhneto
DB_USER=root
DB_PASS=

# Stripe (use chaves de teste sk_test_... em desenvolvimento)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Email transacional (SMTP da Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=RHNeto Pro

# SMS (Infobip) — deixe INFOBIP_ENABLED=false para não enviar SMS
INFOBIP_ENABLED=false
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=RHNeto
INFOBIP_TIMEOUT=10
